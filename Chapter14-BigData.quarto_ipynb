        "mean = [0, 0]\n",
        "cov_matrix = [[1, 0.7], [0.7, 1]]\n",
        "\n",
        "# Generate 100 observations of X1 and X2\n",
        "np.random.seed(124)\n",
        "X = np.random.multivariate_normal(mean, cov_matrix, 200)\n",
