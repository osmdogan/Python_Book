      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "np.sum(x, 1)  # sum of rows, 3 elements"
      ],
      "id": "2cb49e85",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "np.cumsum(x, 0)  # cumulative sum of columns"
      ],
      "id": "444a83d7",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# Generate 3x4 array of draws from N(0,1)\n",
        "x = np.random.randn(3, 4)\n",
        "x"
      ],
