        "predictions = r1.predict(new_data)\n",
        "\n",
        "# Compute difference in probabilities\n",
        "probability_difference = predictions.diff().iloc[-1]\n",
        "print(\"Difference in predicted probabilities:\", probability_difference.round(3))"
