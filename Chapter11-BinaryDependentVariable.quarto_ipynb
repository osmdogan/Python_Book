        "probit = smf.probit('deny ~ pirat', data=mydata).fit(disp=0)\n",
        "logit = smf.logit('deny ~ pirat', data=mydata).fit(disp=0)\n",
        "\n",
        "# Scatter plot of observed data\n",
        "plt.figure(figsize=(6, 4))\n",
