        "y_logit = logit.predict(pd.DataFrame({'pirat': x}))\n",
        "\n",
        "# Plot estimated regression lines\n",
        "plt.plot(x, y_probit, lw=1, color='blue', label='Probit model')\n",
        "plt.plot(x, y_logit, lw=1, color='red', linestyle='--', label='Logit model')\n",
        "\n",
