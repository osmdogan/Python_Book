        "\n",
        "plt.plot(intersection_quantity3, intersection_price3, 'bo') \n",
        "plt.annotate('Equilibrium 3', xy=(intersection_quantity3, intersection_price3), xytext=(-8, 8), textcoords='offset points', color='black', fontsize=8)\n",
        "\n",
