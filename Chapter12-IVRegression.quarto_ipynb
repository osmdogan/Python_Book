        "#| fig-cap: Equilibrium price and quantity for 11 periods\n",
        "#| label: fig-fig19-2\n",
        "# Additional equilibrium points\n",
        "additional_points = {\n",
        "    'quantity': [35, 45, 50, 60, 70, 75, 60, 50, 90],\n",
        "    'price': [90, 92, 100, 95, 83, 100, 95, 75, 80]\n",
        "}\n",
        "\n",
        "# Create the scatter plot\n",
        "plt.figure(figsize=(5, 4))\n",
        "plt.scatter(additional_points['quantity'], additional_points['price'], color='steelblue', label='Additional Points')\n",
        "\n",
        "# Plot the intersection points\n",
        "plt.scatter([intersection_quantity1, intersection_quantity2, intersection_quantity3],\n",
        "            [intersection_price1, intersection_price2, intersection_price3], color='blue', label='Intersection Points')\n",
        "\n",
        "# Add labels\n",
        "plt.xlabel('Quantity')\n",
        "plt.ylabel('Price')\n",
