        "#|   - The U.S. unemployment rate\n",
        "#|   - The U.S. dollar / British pound exchange rate\n",
        "#|   - The quarterly U.S. real GDP\n",
        "#|   - The log of Japan’s industrial production index\n",
        "#| layout-ncol: 2\n",
        "# Time series plots of four economic variables\n",
        "# Taking a subset\n",
        "newdata = dfMacro.loc['1960-01-01':'2013-12-31']\n",
        "\n",
        "# Plot the U.S. unemployment rate\n",
        "plt.figure(figsize=(4, 4))\n",
